rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the current user's UID exists in the 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Catalog collection
    match /catalog/{document=**} {
      // Anyone can read products
      allow read: if true;
      // Only admins can write/update/delete products
      allow write: if isAdmin();
    }

    // Reviews collection
    match /reviews/{document=**} {
      // Anyone can read reviews
      allow read: if true;
      // Any logged-in user can create a review
      allow create: if request.auth != null;
      // Only admins can update or delete reviews
      allow update, delete: if isAdmin();
    }

    // Settings collection (Marketing config, etc)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection
    match /admins/{document=**} {
      // Admins can read the admins list
      allow read: if isAdmin();
      allow write: if false; // Must be modified directly in Firebase Console
    }
    
    // Orders collection (if used later)
    match /orders/{document=**} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.userId);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
